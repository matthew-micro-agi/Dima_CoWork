#!/usr/bin/env -S python3 -I
"""Laptop-only CBOR <-> JSON for the node's control interface (DL-04).

  icd-json to-json  < reply.cbor          print a CBOR reply as JSON
  icd-json to-cbor '{"session": 7, ...}'  write a JSON request as CBOR to stdout

Keys are written in the order given: send request keys in the ICD's order
(icd/fwt-icd-v1.cddl). Needs cbor2 (tools-requirements.txt, laptop venv).
"""
import json
import sys

import cbor2


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "to-json":
        data = sys.stdin.buffer.read()
        if not data:
            print("(empty)")
            return 1
        print(json.dumps(cbor2.loads(data)))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "to-cbor":
        sys.stdout.buffer.write(cbor2.dumps(json.loads(sys.argv[2])))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
