#!/usr/bin/env -S python3 -I
"""Laptop-only CBOR <-> JSON for the node's control interface (DL-04).

  icd-json to-json  < reply.cbor          print a CBOR reply as JSON
  icd-json to-cbor '{"session": 7, ...}'  write a JSON request as CBOR to stdout

Keys are written in the order given: send request keys in the ICD's order
(icd/fwt-icd-v1.cddl). Needs cbor2: uses the repo's laptop venv (.venv)
automatically when started with the system python3.
"""
import json
import os
import sys

try:
    import cbor2
except ModuleNotFoundError:
    # Started with the system python3: re-run with the repo's laptop venv
    # (docs/setup.md 2.4), which has cbor2. Once only (no loop).
    here = os.path.dirname(os.path.realpath(__file__))
    venv_py = os.path.join(here, "..", ".venv", "bin", "python")
    if os.path.exists(venv_py) and not os.environ.get("ICD_JSON_REEXEC"):
        os.environ["ICD_JSON_REEXEC"] = "1"
        os.execv(venv_py, [venv_py, "-I", os.path.realpath(__file__)] + sys.argv[1:])
    sys.exit("icd-json: needs cbor2: set up the laptop venv (docs/setup.md section 2.4)")


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "to-json":
        data = sys.stdin.buffer.read()
        if not data:
            print("(empty)")
            return 1
        print(json.dumps(cbor2.loads(data)))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "to-cbor":
        sys.stdout.buffer.write(cbor2.dumps(json.loads(sys.argv[2])))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
